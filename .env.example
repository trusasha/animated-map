OPENAI_API_KEY=
# optional
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# photo → 3D figure (fal.ai Hunyuan3D v3, ~$0.375 per model)
FAL_KEY=
# empty = embedded local Postgres (PGlite in ./data/pg); set to Supabase Postgres URL to switch
DATABASE_URL=
PORT=5173
# accounts via Supabase Auth (project URL + publishable key). Empty = auth off: one local user, as before
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# trips/figures/settings from before accounts go to this account on its first sign-in, once
CLAIM_LEGACY_FOR=
# opens /api/health/stats (pass as ?token= or x-health-token); without it stats are open only while auth is off
HEALTH_TOKEN=
