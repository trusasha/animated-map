    "@electric-sql/pglite": "^0.5.8",
    "@fontsource-variable/inter": "^5.3.0",
    "@supabase/supabase-js": "^2.117.3",
    "express": "^5.2.1",
    "jose": "^6.2.12",
    "lucide-react": "^1.53.0",
    "maplibre-gl": "^6.13.0",
    "mp4-muxer": "^5.2.2",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.59",
